<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Folium.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Folium.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/foliumLogo.ico"
        Title="Folium"
        Width="1000"
        Height="640"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>

        <!-- Sidebar de navigation -->
        <Border DockPanel.Dock="Left"
                Width="190"
                Background="{DynamicResource BrushSidebarBg}"
                Padding="0,16,0,16">
            <StackPanel Spacing="2">

                <!-- Titre app -->
                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,16"
                            Spacing="8">
                    <Border Width="64"
                            Height="64"
                            CornerRadius="10"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Image Source="/Assets/foliumLogo.ico" />
                    </Border>
                    <TextBlock Text="Folium"
                               Foreground="{DynamicResource BrushTextNavItem}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Section PDF -->
                <TextBlock Text="PDF"
                           Foreground="{DynamicResource BrushTextSidebarSection}"
                           FontSize="11"
                           Margin="16,8,0,4" />

                <Button Classes="NavItem"
                        Content="Fusionner"
                        Command="{Binding NavigateToPdfMergeCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,8"
                        Background="Transparent"
                        Foreground="{DynamicResource BrushTextNavItem}"
                        CornerRadius="0" />

                <Button Classes="NavItem"
                        Content="Diviser"
                        Command="{Binding NavigateToPdfSplitCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,8"
                        Background="Transparent"
                        Foreground="{DynamicResource BrushTextNavItem}"
                        CornerRadius="0" />

                <Button Classes="NavItem"
                        Content="Compresser"
                        Command="{Binding NavigateToPdfCompressCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,8"
                        Background="Transparent"
                        Foreground="{DynamicResource BrushTextNavItem}"
                        CornerRadius="0" />

                <Button Classes="NavItem"
                        Content="Pivoter"
                        Command="{Binding NavigateToPdfRotateCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,8"
                        Background="Transparent"
                        Foreground="{DynamicResource BrushTextNavItem}"
                        CornerRadius="0" />

                <!-- Section Images -->
                <TextBlock Text="IMAGES"
                           Foreground="{DynamicResource BrushTextSidebarSection}"
                           FontSize="11"
                           Margin="16,16,0,4" />

                <Button Classes="NavItem"
                        Content="Convertir"
                        Command="{Binding NavigateToImageConvertCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,8"
                        Background="Transparent"
                        Foreground="{DynamicResource BrushTextNavItem}"
                        CornerRadius="0" />

                <Button Classes="NavItem"
                        Content="Redimensionner"
                        Command="{Binding NavigateToImageResizeCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,8"
                        Background="Transparent"
                        Foreground="{DynamicResource BrushTextNavItem}"
                        CornerRadius="0" />

            </StackPanel>
        </Border>

        <!-- Zone de contenu principale — ViewLocator instancie la View correspondante -->
        <ContentControl Content="{Binding CurrentPage}"
                        Background="{DynamicResource BrushContentBg}" />

    </DockPanel>

</Window>
