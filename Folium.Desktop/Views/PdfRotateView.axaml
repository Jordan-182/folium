<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Folium.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="Folium.Desktop.Views.PdfRotateView"
             x:DataType="vm:PdfRotateViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="32">

        <!-- Titre -->
        <TextBlock Grid.Row="0"
                   Text="Pivoter un PDF"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTextPrimary}"
                   Margin="0,0,0,24" />

        <!-- Fichier source -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Row="0"
                       Text="Fichier PDF source"
                       Foreground="{DynamicResource BrushTextLabel}"
                       Margin="0,0,0,8" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding InputPath}"
                         PlaceholderText="Sélectionner un fichier PDF..."
                         Background="{DynamicResource BrushInputBg}"
                         Foreground="{DynamicResource BrushTextPrimary}"
                         BorderBrush="{DynamicResource BrushBorder}"
                         CornerRadius="6"
                         Padding="10,8"
                         IsReadOnly="True" />
                <Button Grid.Column="1"
                        Content="Parcourir"
                        Command="{Binding BrowseInputCommand}"
                        Margin="8,0,0,0"
                        Background="{DynamicResource BrushSecondaryBtnBg}"
                        Foreground="{DynamicResource BrushTextPrimary}"
                        Padding="12,8"
                        CornerRadius="4" />
            </Grid>
        </Grid>

        <!-- Options de rotation -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,0,0,16">

            <!-- Angle -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto" Margin="0,0,12,0">
                <TextBlock Grid.Row="0"
                           Text="Angle de rotation"
                           Foreground="{DynamicResource BrushTextLabel}"
                           Margin="0,0,0,8" />
                <ComboBox Grid.Row="1"
                          ItemsSource="{Binding AvailableDegrees}"
                          SelectedItem="{Binding SelectedDegrees}"
                          Background="{DynamicResource BrushInputBg}"
                          Foreground="{DynamicResource BrushTextPrimary}"
                          BorderBrush="{DynamicResource BrushBorder}"
                          CornerRadius="6"
                          Padding="10,8"
                          HorizontalAlignment="Stretch" />
            </Grid>

            <!-- Pages (optionnel) -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0"
                           Text="Pages à pivoter (optionnel) — ex : 1,3,5"
                           Foreground="{DynamicResource BrushTextLabel}"
                           Margin="0,0,0,8" />
                <TextBox Grid.Row="1"
                         Text="{Binding PageNumbersText}"
                         PlaceholderText="Laisser vide pour toutes les pages"
                         Background="{DynamicResource BrushInputBg}"
                         Foreground="{DynamicResource BrushTextPrimary}"
                         BorderBrush="{DynamicResource BrushBorder}"
                         CornerRadius="6"
                         Padding="10,8" />
            </Grid>

        </Grid>

        <!-- Fichier de sortie -->
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Row="0"
                       Text="Fichier de sortie"
                       Foreground="{DynamicResource BrushTextLabel}"
                       Margin="0,0,0,8" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding OutputPath}"
                         PlaceholderText="Enregistrer sous..."
                         Background="{DynamicResource BrushInputBg}"
                         Foreground="{DynamicResource BrushTextPrimary}"
                         BorderBrush="{DynamicResource BrushBorder}"
                         CornerRadius="6"
                         Padding="10,8"
                         IsReadOnly="True" />
                <Button Grid.Column="1"
                        Content="Parcourir"
                        Command="{Binding BrowseOutputCommand}"
                        Margin="8,0,0,0"
                        Background="{DynamicResource BrushSecondaryBtnBg}"
                        Foreground="{DynamicResource BrushTextPrimary}"
                        Padding="12,8"
                        CornerRadius="4" />
            </Grid>
        </Grid>

        <!-- Action + progression + status -->
        <StackPanel Grid.Row="4" Spacing="10">

            <Button Content="Pivoter"
                    Command="{Binding RotateCommand}"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource BrushAccent}"
                    Foreground="{DynamicResource BrushOnAccent}"
                    FontWeight="SemiBold"
                    Padding="24,10"
                    CornerRadius="6" />

            <ProgressBar Value="{Binding ProgressValue}"
                         Minimum="0"
                         Maximum="100"
                         IsVisible="{Binding IsBusy}"
                         Height="4"
                         CornerRadius="2"
                         Foreground="{DynamicResource BrushAccent}"
                         Background="{DynamicResource BrushProgressTrack}" />

            <TextBlock Text="{Binding StatusMessage}"
                       IsVisible="{Binding !IsError}"
                       Foreground="{DynamicResource BrushStatusSuccess}"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding StatusMessage}"
                       IsVisible="{Binding IsError}"
                       Foreground="{DynamicResource BrushStatusError}"
                       TextWrapping="Wrap" />

        </StackPanel>

    </Grid>

</UserControl>
